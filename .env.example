# GLMAdapter — .env fallback for the Together AI key.
#
# PREFER the OS secret store (the key never touches disk):
#   macOS : security add-generic-password -U -s TOGETHER_API_KEY -a "$USER" -w 'YOUR_KEY'
#   Linux : echo -n 'YOUR_KEY' | secret-tool store --label='Together AI' service TOGETHER_API_KEY
#
# Only if you can't use a secret store (e.g. headless Linux): copy this file to
# .env and fill in the key. .env is gitignored — NEVER commit it.
TOGETHER_API_KEY=your_together_key_here
